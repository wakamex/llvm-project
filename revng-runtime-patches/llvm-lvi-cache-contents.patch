+size_t llvm::getLazyValueInfoCacheContents(
+    const LazyValueInfo &LVI, SmallVectorImpl<Value *> &TrackedValues) {
+  if (!LVI.PImpl)
+    return 0;
+  return static_cast<const LazyValueInfoImpl *>(LVI.PImpl)->getCacheContents(
+      TrackedValues);
+}
